# Local development defaults. Copy to an ignored .env.local and replace the
# Google client ID with the client used by the backend environment.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080

# For a Vercel deployment, configure build-time environment variables in
# Vercel instead of committing an environment file:
# VITE_GOOGLE_CLIENT_ID=<the same client ID configured by the target backend>
# VITE_API_BASE_URL=https://api.dev.subtrak.xyz
